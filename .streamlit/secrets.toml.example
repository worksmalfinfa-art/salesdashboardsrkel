# ============================================================================
# Template for Streamlit secrets — copy to .streamlit/secrets.toml for local
# development, or paste into Streamlit Cloud → App settings → Secrets.
#
# .streamlit/secrets.toml is gitignored. This .example file must never contain
# real values.
# ============================================================================

[supabase]
# Supabase Studio → Project Settings → Data API
url = "https://YOUR-PROJECT-REF.supabase.co"

# The service_role key, NOT the anon key. It bypasses Row Level Security,
# which is what the app needs since it enforces access itself in check_auth().
# Treat it like a database password — it must never reach the browser or Git.
service_key = "YOUR-SERVICE-ROLE-KEY"
